# Copie ce fichier vers .env et remplis les valeurs.
#   cp .env.example .env
#
# .env est dans .gitignore et ne doit JAMAIS être versionné.
# Si un secret est parti dans un commit, le retirer du code ne suffit pas :
# il faut le révoquer côté Discord et en générer un nouveau.

# --- Base de données -------------------------------------------------------
DB_NAME=miyoshix
DB_USER=miyoshix
# Génère-en un au hasard :  openssl rand -base64 24
DB_PASSWORD=

# URL utilisée par Spring Boot (le conteneur écoute sur 127.0.0.1:5432)
DB_URL=jdbc:postgresql://localhost:5432/miyoshix

# --- Application Discord ---------------------------------------------------
# https://discord.com/developers/applications -> ton application -> OAuth2
# Déclare ces URL de redirection exactement comme ceci dans "Redirects" :
#   http://localhost:4200/login/oauth2/code/discord   (front via ng serve)
#   http://localhost:8080/login/oauth2/code/discord   (back seul, ou front buildé servi par Spring)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Amorçage --------------------------------------------------------------
# Ton identifiant Discord, pour créer le premier compte autorisé (rôle ADMIN).
# Pour l'obtenir : Discord -> Paramètres -> Avancés -> Mode développeur, puis
# clic droit sur ton propre nom -> "Copier l'identifiant".
PORTAL_BOOTSTRAP_ADMIN=

# --- Fournisseur d'identité (modules) --------------------------------------
# Adresse publique du portail. En production : https://miyoshiix.com
PORTAL_ISSUER=http://localhost:8080
# Clé privée qui signe les jetons des modules. Vide en local : clé éphémère,
# les modules devront se reconnecter après chaque redémarrage du portail.
# Pour en générer une (une seule ligne) :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 -w0
PORTAL_OIDC_SIGNING_KEY=

# --- Module Médecinetopia ---------------------------------------------------
# Adresse du site, sans barre finale. En production : https://medecinetopia.miyoshiix.com
MODULE_MEDECINETOPIA_URL=http://medecinetopia.localhost:8081
# true quand le module est en ligne : affiche la tuile et enregistre le client.
MODULE_MEDECINETOPIA_ENABLED=false
# Secret partagé avec le module (même valeur des deux côtés) :  openssl rand -base64 32
MODULE_MEDECINETOPIA_CLIENT_SECRET=

# --- Divers ----------------------------------------------------------------
# Port local. Ne pas définir sur Railway, qui fournit PORT (SERVER_PORT l'emporterait).
SERVER_PORT=8080
# false en local (HTTP), true en production (HTTPS obligatoire)
COOKIE_SECURE=false
